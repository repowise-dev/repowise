{
  "about": "Shared conformance cases for chat view parts. The TypeScript validator (packages/api-client/src/views.test.ts) and the server models (tests/unit/server/test_view_parts_contract.py) both run every case, so they accept and reject the same payloads. An invalid case copies a valid part (from), then applies drop (paths), set (path to value) and grow (path to length, repeating the array's first item). Paths are dotted; numeric segments index arrays. error is the substring the TypeScript validator reports. valid_variants are accepted by both sides but not round-tripped (JSON writes -0 as 0). Strings have no maximum length, only non-empty, so UTF-16 units and code points agree; ids and column keys are ASCII patterns. Numbers stay within +/-(2^53 - 1). Valid parts are written at schema version 1, as parts stored before version 2 are, so both sides prove those still validate.",
  "vocabulary": {
    "schema_version": 2,
    "schema_versions": [1, 2],
    "max_wire_number": 9007199254740991,
    "view_kinds": ["table", "chart", "section"],
    "chart_types": ["bar", "horizontal_bar", "stacked_bar", "line", "area", "donut", "scatter", "treemap", "heatmap"],
    "coverage_metrics": ["attribution", "test_reach"],
    "sort_orders": ["asc", "desc"],
    "basis_kinds": ["measured", "inferred", "declared", "unresolved"],
    "ref_types": ["repo", "file", "symbol", "module", "component", "commit", "change", "decision"]
  },
  "limits": {
    "parts": 50,
    "columns": 20,
    "rows": 500,
    "chart_points": 100,
    "chart_series": 8,
    "donut_min_parts": 2,
    "donut_max_parts": 8,
    "treemap_groups": 3,
    "narrative_blocks": 50,
    "section_views": 20
  },
  "fields": {
    "CardBasis": ["kind", "source"],
    "CardRef": ["type", "id", "start_line", "end_line"],
    "ViewSource": ["artifact_id", "tool_name", "args_hash"],
    "ViewCoverage": ["metric", "ratio"],
    "ViewColumn": ["key", "label", "unit", "basis"],
    "ViewTableData": ["columns", "rows", "total_rows", "truncated"],
    "NarrativeBlock": ["text", "cites"],
    "TableView": ["schema_version", "kind", "id", "title", "summary", "source", "basis", "coverage", "stale", "as_of", "columns", "rows", "total_rows", "truncated"],
    "ChartView": ["schema_version", "kind", "id", "title", "summary", "source", "basis", "coverage", "stale", "as_of", "chart_type", "data", "x", "series", "sort", "groups", "color"],
    "SectionView": ["schema_version", "kind", "id", "title", "summary", "narrative", "view_ids"]
  },
