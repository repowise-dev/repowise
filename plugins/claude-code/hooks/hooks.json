{
  "modules": ["./lens/lens.js"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v repowise-augment >/dev/null 2>&1; then exec repowise-augment; fi",
            "timeout": 10,
            "statusMessage": "Loading repowise context..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Grep|Glob|Read|Edit|Write|mcp__.*[Rr]epowise.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v repowise-augment >/dev/null 2>&1; then exec repowise-augment; fi",
            "timeout": 10,
            "statusMessage": "Checking codebase context..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *\"git commit\"*) if command -v repowise-augment >/dev/null 2>&1; then printf \"%s\" \"$input\" | repowise-augment; fi;; esac",
            "timeout": 10,
            "statusMessage": "Checking for a decision to record..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v repowise-augment >/dev/null 2>&1; then exec repowise-augment; fi",
            "timeout": 10,
            "statusMessage": "Checking codebase context..."
          }
        ]
      }
    ]
  }
}
